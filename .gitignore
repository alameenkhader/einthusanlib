# Bundler
/.bundle

# Environment files (except templates)
/.env*
!/.env*.erb

# Runtime data: completed movies live in storage/, downloads in tmp/
/storage/*
*.sqlite3
*.sqlite3-*
/tmp/*

# Bundled gems on Termux (generated by `bundle config set path vendor/bundle`)
vendor/bundle

# Python virtualenv (youtube-dl) and abandoned experiment dirs
venv*
path/

# Assets
/public/assets

# Tooling
.DS_Store
/.ruby-lsp/
/coverage/