# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore bundler config.
/.bundle

# Ignore all environment files (except templates).
/.env*
!/.env*.erb

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore cache files
/tmp/cache/*
!/tmp/cache/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep
storage*

# Ignore assets.
/public/assets

# Ignore the public/movies directory
public/movies

# Ignore master key for decrypting credentials and more.
/config/master.key
/config/credentials/*.key

# Ignore application configuration
/config/application.yml

# Ignore database files
*.sqlite3
*.sqlite3-*

# Ignore bootsnap cache
/tmp/bootsnap*

# Ignore node modules
/node_modules

# Ignore yarn files
/yarn-error.log
yarn-debug.log*
.yarn-integrity

# Ignore byebug command history file.
.byebug_history

# Ignore Spring files.
/spring/*.pid

# Ignore Capistrano files
/config/deploy/*

# Ignore secrets
secrets/*

# Ignore system files
.DS_Store
Thumbs.db
*~

# Ignore temporary files
*.tmp
*.swp
.*.swp
.*.swo

# Ignore coverage reports
/coverage/

# Ignore simplecov generated files
coverage

# Ignore RubyMine files
/.idea
*.iml

# Ignore vim files
*.un~
Session.vim

# Ignore Emacs files
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# Ignore VS Code files
.vscode/

# Ignore local environment variables
.env.local
.env.development.local
.env.test.local
.env.production.local
.aider/

# Ignore Rails specific files
*.rbc
capybara-*.html
.rspec
/db/*.sqlite3
/db/*.sqlite3-journal
/db/*.sqlite3-[0-9]*
/public/system
/spec/tmp
**.orig
rerun.txt
pickle-email-*.html

# Ignore application specific files
main.log

venv*
