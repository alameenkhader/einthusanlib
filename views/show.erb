<div class="container-fluid px-3 py-3">
  <div class="card mx-auto" style="max-width: 400px;">
    <img src="<%= @movie.image_url %>" class="card-img-top" alt="<%= @movie.title %>">

    <div class="card-body text-center">
      <h5 class="card-title"><%= @movie.title %></h5>
      <p class="text-muted small">Released: <%= @movie.released_at&.strftime('%Y') || 'Unknown' %></p>

      <% if @status[:state] == :watchable %>
        <a href="<%= stream_path(@movie) %>" class="btn btn-success w-100">Watch Now</a>
      <% elsif @status[:state] == :downloading %>
        <div class="alert alert-warning mb-1">
          Downloading <%= @status[:progress] ? "#{@status[:progress][:percent]}%" : '...' %>
        </div>
        <p class="text-muted small mb-0"><%= format_progress(@status[:progress]) %></p>
      <% elsif @status[:state] == :requested %>
        <div class="alert alert-info mb-1">
          Requested<%= @status[:failed] ? ' · will retry' : '' %>
        </div>
        <p class="text-muted small mb-0">Downloads automatically on the next sweep. Refresh this page later.</p>
      <% else %>
        <form method="post" action="<%= request_movie_path(@movie) %>">
          <button type="submit" class="btn btn-outline-light w-100">Request Download</button>
        </form>
      <% end %>
    </div>
  </div>
</div>