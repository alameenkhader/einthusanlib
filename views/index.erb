<div class="container mt-4">
  <% if @movies && @movies.any? %>
    <div class="row mb-5">
      <div class="col-12">
        <h2 class="text-white mb-4">
          <% if params[:search] %>
            Search Results for "<%= params[:search] %>"
          <% end %>
        </h2>

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
          <% @movies.each do |movie| %>
            <div class="col">
              <div class="card media-card">
                <a href="<%= movie_path(movie) %>" class="media-link" target="_blank">
                  <img src="<%= movie.image_url %>" class="card-img-top media-img" alt="<%= movie.title %>" style="height: 300px; object-fit: cover;">
                  <div class="card-body">
                    <h5 class="card-title"><%= movie.title %></h5>
                    <p class="text-muted small">
                      Released: <%= movie.released_at&.strftime('%Y') || 'Unknown' %>
                    </p>
                  </div>
                </a>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% elsif params[:search] %>
    <div class="alert alert-warning mb-4" role="alert">
      No movies found for "<%= params[:search] %>". Try a different search term.
    </div>
  <% end %>

  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card">
        <div class="card-body">
          <form action="<%= movies_path %>" method="get" class="d-flex gap-2">
            <input type="text" name="search"
                placeholder="Enter movie title..."
                value="<%= params[:search] %>"
                class="form-control">
            <button type="submit" class="btn btn-outline-light">Search</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>