<div class="container mt-4">
  <% if @movies && @movies.any? %>
    <div class="row mb-5">
      <div class="col-12">
        <h2 class="text-white mb-4">
          <% if params[:search] %>
            Search Results for "<%= params[:search] %>"
          <% end %>
        </h2>

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
          <% @movies.each do |movie| %>
            <% status = Status.for(movie) %>
            <div class="col">
              <div class="card media-card h-100">
                <a href="<%= movie_path(movie) %>" class="media-link">
                  <img src="<%= movie.image_url %>" class="card-img-top media-img" alt="<%= movie.title %>" style="height: 300px; object-fit: cover;">
                </a>
                <div class="card-body d-flex flex-column">
                  <h5 class="card-title"><%= movie.title %></h5>
                  <p class="text-muted small">
                    Released: <%= movie.released_at&.strftime('%Y') || 'Unknown' %>
                  </p>
                  <div class="mt-auto">
                    <% if status[:state] == :watchable %>
                      <a href="<%= stream_path(movie) %>" class="btn btn-success btn-sm w-100">Watch</a>
                    <% elsif status[:state] == :downloading %>
                      <span class="badge text-bg-warning w-100 py-2">
                        Downloading <%= status[:progress] ? "#{status[:progress][:percent]}%" : '...' %>
                      </span>
                    <% elsif status[:state] == :requested %>
                      <span class="badge text-bg-info w-100 py-2">
                        Requested<%= status[:failed] ? ' · will retry' : '' %>
                      </span>
                    <% else %>
                      <form method="post" action="<%= request_movie_path(movie) %>">
                        <button type="submit" class="btn btn-outline-light btn-sm w-100">+ Request</button>
                      </form>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% elsif params[:search] %>
    <div class="alert alert-warning mb-4" role="alert">
      No movies found for "<%= params[:search] %>". Try a different search term.
    </div>
  <% end %>

  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card">
        <div class="card-body">
          <form action="<%= movies_path %>" method="get" class="d-flex gap-2">
            <input type="text" name="search"
                placeholder="Enter movie title..."
                value="<%= params[:search] %>"
                class="form-control">
            <button type="submit" class="btn btn-outline-light">Search</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>