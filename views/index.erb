<% if @notice %>
  <div class="alert alert-warning" role="alert"><%= @notice %></div>
<% end %>

<div class="row justify-content-center mb-4">
  <div class="col-md-8">
    <div class="card">
      <div class="card-body">
        <form action="/downloads" method="post" class="d-flex gap-2">
          <input type="url" name="url"
              placeholder="Paste an einthusan.tv movie URL..."
              class="form-control" required>
          <button type="submit" class="btn btn-outline-light" id="download-btn">Download</button>
        </form>
      </div>
    </div>
  </div>
</div>

<div class="row justify-content-center mb-4">
  <div class="col-md-8">
    <div class="card">
      <div class="card-body" id="status-panel" data-download-state="<%= @status[:state] %>">
        <% if @status[:state] == :downloading %>
          <p class="mb-1"><strong>Downloading</strong> <span id="download-name"><%= @status[:filename] %></span></p>
          <div class="progress mb-2" style="height: 20px;">
            <div class="progress-bar" id="progress-bar" style="width: <%= @status[:progress] ? @status[:progress][:percent] : 0 %>%"></div>
          </div>
          <p class="text-muted small mb-0" id="progress-text">
            <%= format_progress(@status[:progress]) %>
          </p>
        <% elsif @status[:state] == :done %>
          <div class="alert alert-success mb-0">
            Done: <%= @status[:filename] %> — <a href="/watch/<%= @status[:filename] %>" class="alert-link">Watch</a>
          </div>
        <% elsif @status[:state] == :error %>
          <div class="alert alert-danger mb-0">
            Download failed: <%= @status[:error] %>
          </div>
        <% else %>
          <p class="text-muted mb-0">Nothing downloading. Paste a movie URL above to start.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>

<% if @library.any? %>
  <h5 class="text-white mb-3">Downloaded (<%= @library.length %>)</h5>
  <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    <% @library.each do |file| %>
      <div class="col">
        <div class="card media-card h-100">
          <div class="card-body d-flex flex-column">
            <h5 class="card-title"><%= file[:name] %></h5>
            <p class="text-muted small">Downloaded <%= file[:mtime].strftime('%Y-%m-%d %H:%M') %></p>
            <div class="mt-auto">
              <a href="/watch/<%= file[:name] %>" class="btn btn-success btn-sm w-100">Watch</a>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>