<div class="container mt-4">
  <!-- Movies Results Section -->
  <% if @movies && @movies.any? %>
    <div class="row mb-5">
      <div class="col-12">
        <h2 class="text-white mb-4">
          <% if params[:search] %>
            Search Results for "<%= params[:search] %>"
          <% end %>
        </h2>

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
          <% @movies.each do |movie| %>
            <div class="col">
              <div class="card media-card">
                <a href="<%= movie_path(movie) %>" class="media-link">
                  <img src="<%= movie.image_url %>" class="card-img-top media-img" alt="<%= movie.title %>" style="height: 300px; object-fit: cover;">
                  <div class="card-body">
                    <h5 class="card-title"><%= movie.title %></h5>
                    <p class="text-muted small">
                      Released: <%= movie.released_at.strftime('%Y') %>
                    </p>
                  </div>
                </a>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% elsif params[:search] %>
    <div class="alert alert-warning mb-4" role="alert">
      No movies found for "<%= params[:search] %>". Try a different search term.
    </div>
  <% end %>

  <!-- Search Form Section -->
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card">
        <div class="card-body">
          <h5 class="card-title text-center mb-4">Search Movies</h5>
          <%= form_with url: movies_path, method: :get, local: true, class: "d-flex gap-2" do |form| %>
            <%= form.text_field :search,
                placeholder: "Enter movie title...",
                value: params[:search],
                class: "form-control" %>
            <%= form.submit "Search", class: "btn btn-outline-light" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  body {
    background-color: #121212;
    color: #f5f5f5;
  }
  .media-card {
    height: 100%;
    transition: transform 0.3s ease;
    background-color: #1e1e1e;
    border-color: #333;
  }
  .media-card:hover {
    transform: scale(1.05);
    box-shadow: 0 10px 20px rgba(0,0,0,0.5);
  }
  .media-link {
    color: #f5f5f5;
    text-decoration: none;
    display: block;
  }
  .media-link:hover {
    color: #f5f5f5;
    text-decoration: none;
  }
  .media-img {
    object-fit: cover;
  }
  .card-title {
    margin-bottom: 0.5rem;
    color: #f5f5f5;
  }
  .card {
    background-color: #1e1e1e;
    border-color: #333;
  }
  .card-body {
    background-color: #1e1e1e;
  }
</style>
